# Copy to .dev.vars for use with `wrangler dev` (that file is gitignored).
ADMIN_TOKEN="dev-admin-token"
UPLOAD_HMAC_SECRET="dev-upload-secret-change-me"
# Prefix for the "view detail" links in notifications. In production this is your
# workers.dev address or custom domain — no trailing slash.
PUBLIC_BASE_URL="http://localhost:8787"
# NOTIFY_WEBHOOK_URL="https://hooks.slack.com/services/xxx"

# Bark push on every new feedback. Both are needed; a self-hosted server works, since
# this target is explicit rather than sniffed from NOTIFY_WEBHOOK_URL's host.
# BARK_SERVER_URL="https://api.day.app"
# BARK_DEVICE_KEY="your-device-key"

# Batch translation of prompt copy. Without TRANSLATE_API_KEY the console hides the
# Translate button; everything else works.
# TRANSLATE_PROVIDER="anthropic"          # anthropic (default) | openai
# TRANSLATE_API_KEY="sk-ant-..."
# TRANSLATE_MODEL="claude-opus-5"         # required when provider is openai
# TRANSLATE_BASE_URL="https://api.deepseek.com/v1"   # any OpenAI-compatible endpoint

# Replying to feedback by email, through Resend (https://resend.com). Without
# RESEND_API_KEY the console falls back to a mailto: link; nothing else changes.
# RESEND_API_KEY="re_..."
# RESEND_FROM="Support <support@mail.example.com>"  # domain must be verified in Resend
# RESEND_REPLY_TO="support@support.example.com"     # where the user's reply lands
